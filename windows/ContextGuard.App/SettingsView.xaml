<UserControl
    x:Class="ContextGuard.App.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- What the Settings window shows, as the Mac's SettingsView: the brand's background right up under the title,
         which is drawn the Windows way (Windows' caption buttons sit over the bar's right end); the tabs; then every
         tab laid out, one shown, so the window is as tall as the tallest and never jumps. -->
    <UserControl.Resources>
        <!-- The tabs are made in code; under Native AOT a style looked up from code comes back as the wrong type, so
             they get theirs from here. -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource BrandTabStyle}" />
    </UserControl.Resources>
    <Grid x:Name="Root" Background="{ThemeResource BrandBgBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Activation">
                <VisualState x:Name="Active" />
                <VisualState x:Name="Inactive">
                    <VisualState.Setters>
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource BrandDisabledBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Height="32" Background="Transparent">
            <TextBlock x:Name="TitleText" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource BrandHeadingBrush}" AutomationProperties.AccessibilityView="Raw" />
        </Grid>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" IsTabStop="False" HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Width="600" HorizontalAlignment="Left" Padding="24,8,24,24" Spacing="20">
                <!-- The rule over the tabs, as the Mac's: it covers the lower half of the selected tab's 2 px underline. -->
                <Grid>
                    <StackPanel x:Name="TabBar" Orientation="Horizontal" Spacing="24" />
                    <Border Style="{StaticResource BrandRuleStyle}" VerticalAlignment="Bottom" IsHitTestVisible="False" />
                </Grid>
                <Grid x:Name="Pages" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
