<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app: the tray icon and its menu, the popups and Settings. It draws what
       `context-guard ui` says (ContextGuard.Feed) and sends back what you click. WinUI 3, unpackaged,
       self-contained, Native AOT (spike W9). Built and published on its own, not through the .slnx: it
       is x64 only. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>ContextGuard.App</RootNamespace>
    <AssemblyName>ContextGuard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The WinUI component only, not the metapackage (which adds AI, ML, Search and Widgets). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ContextGuard.Feed\ContextGuard.Feed.csproj" />
  </ItemGroup>
</Project>
