<UserControl
    x:Class="ContextGuard.App.SessionRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One session in the flyout, the Mac's session submenu opened in place: its icon, title and size; a click
         shows where it stands and what you can do with it. -->
    <StackPanel>
        <Button x:Name="Row" Style="{StaticResource MenuRowButtonStyle}" Click="OnRowClick">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="Glyph" FontFamily="Segoe Fluent Icons" FontSize="16" />
                <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TokensText" Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
                <FontIcon x:Name="Chevron" Grid.Column="3" FontFamily="Segoe Fluent Icons" FontSize="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Button>
        <StackPanel x:Name="Details" Visibility="Collapsed" Padding="0,0,0,4">
            <StackPanel Margin="40,2,12,6" Spacing="2">
                <TextBlock x:Name="StatusText" Style="{StaticResource NoteTextStyle}" />
                <TextBlock x:Name="FollowUpText" Style="{StaticResource NoteTextStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource NoteTextStyle}" />
            </StackPanel>
            <Button x:Name="CompactNow" Style="{StaticResource MenuRowButtonStyle}" Padding="40,0,12,0" Click="OnCompactNow" />
            <Button x:Name="Deferral" Style="{StaticResource MenuRowButtonStyle}" Padding="40,0,12,0" Click="OnDeferral" />
            <Button x:Name="ShowQuestion" Style="{StaticResource MenuRowButtonStyle}" Padding="40,0,12,0" Click="OnShowQuestion" />
            <CheckBox x:Name="Watch" Margin="40,0,12,0" Click="OnWatch" />
        </StackPanel>
    </StackPanel>
</UserControl>
