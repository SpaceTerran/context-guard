<Application
    x:Class="ContextGuard.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows' own controls and colors. Brushes are {ThemeResource} here and in the views, so they follow a
         live light/dark switch (W9: brushes looked up from code keep the theme the app started in). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- The brand's colors (Brand<Role>Brush, for dark, light and high contrast), radii and font, written
                     from the Mac's Theme.swift by BrandTokensTests. The popups and Settings wear them. -->
                <ResourceDictionary Source="ms-appx:///Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Where high contrast parts from the brand. In high contrast every hover fill is the system's highlight,
                 so: a control's text under the pointer turns to the highlight's text color; a fill that isn't a hover
                 (an off switch's track, a disabled button) is the window's color, so it doesn't read as hovered or on;
                 an off switch under the pointer shows the highlight on its edge and knob, as Windows' own switch; and
                 a number to fix gets a 2 px edge, since the danger color is the text color there. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="BrandSecondaryHoverTextBrush" ResourceKey="BrandHeadingBrush" />
                    <StaticResource x:Key="BrandGhostHoverTextBrush" ResourceKey="BrandAccentBrush" />
                    <StaticResource x:Key="BrandCloseHoverTextBrush" ResourceKey="BrandHeadingBrush" />
                    <StaticResource x:Key="BrandRestFillBrush" ResourceKey="BrandHoverBrush" />
                    <StaticResource x:Key="BrandSwitchOffHoverBrush" ResourceKey="BrandBorderBrush" />
                    <StaticResource x:Key="BrandSwitchOffHoverEdgeBrush" ResourceKey="BrandBorderStrongBrush" />
                    <StaticResource x:Key="BrandSwitchOffHoverKnobBrush" ResourceKey="BrandMutedBrush" />
                    <Thickness x:Key="BrandInvalidEdgeThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="BrandSecondaryHoverTextBrush" ResourceKey="BrandHeadingBrush" />
                    <StaticResource x:Key="BrandGhostHoverTextBrush" ResourceKey="BrandAccentBrush" />
                    <StaticResource x:Key="BrandCloseHoverTextBrush" ResourceKey="BrandHeadingBrush" />
                    <StaticResource x:Key="BrandRestFillBrush" ResourceKey="BrandHoverBrush" />
                    <StaticResource x:Key="BrandSwitchOffHoverBrush" ResourceKey="BrandBorderBrush" />
                    <StaticResource x:Key="BrandSwitchOffHoverEdgeBrush" ResourceKey="BrandBorderStrongBrush" />
                    <StaticResource x:Key="BrandSwitchOffHoverKnobBrush" ResourceKey="BrandMutedBrush" />
                    <Thickness x:Key="BrandInvalidEdgeThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BrandSecondaryHoverTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="BrandGhostHoverTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="BrandCloseHoverTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="BrandRestFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BrandSwitchOffHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BrandSwitchOffHoverEdgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="BrandSwitchOffHoverKnobBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <Thickness x:Key="BrandInvalidEdgeThickness">2</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- A row of the flyout you click, drawn as Windows 11 draws a menu item: no fill until the
                 pointer is over it, rounded, the text dimmed while pressed or disabled. -->
            <Style x:Key="MenuRowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,0,12,0" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="FocusVisualMargin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Text that says how things stand: the settings' lines, a session's status. -->
            <Style x:Key="NoteTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- "Sessions", above the list. -->
            <Style x:Key="HeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="12,8,12,4" />
            </Style>

            <!-- The brand's buttons, as the Mac's BrandButtonStyle: 32 high, radius 6, the brand's font at 13; flat fills
                 that change under the pointer. Primary (the default answer): violet, bold. Secondary: the panel's
                 fill with a strong edge. Ghost: violet text, no fill until the pointer is over it. -->
            <Style x:Key="BrandButtonBaseStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="14,0,14,0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource BrandControlRadius}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
            </Style>

            <Style x:Key="BrandPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BrandButtonBaseStyle}">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fill" Background="{ThemeResource BrandPrimaryBrush}" BorderBrush="Transparent"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandPrimaryHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandPrimaryHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandRestFillBrush}" />
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}" Foreground="{ThemeResource BrandOnPrimaryBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BrandSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BrandButtonBaseStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fill" Background="{ThemeResource BrandPanelBrush}" BorderBrush="{ThemeResource BrandBorderStrongBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandHoverBrush}" />
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandSecondaryHoverTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandHoverBrush}" />
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandSecondaryHoverTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}" Foreground="{ThemeResource BrandHeadingBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BrandGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BrandButtonBaseStyle}">
                <Setter Property="Padding" Value="10,0,10,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fill" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandHoverBrush}" />
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandGhostHoverTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandHoverBrush}" />
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandGhostHoverTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}" Foreground="{ThemeResource BrandAccentBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A popup's ✕: a small muted cross that darkens on a hover fill. -->
            <Style x:Key="BrandCloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource BrandBadgeRadius}" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Fill" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandHoverBrush}" />
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandCloseHoverTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandHoverBrush}" />
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandCloseHoverTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" Foreground="{ThemeResource BrandMutedBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Settings' tabs, as the Mac's TabBar: words over a line, the selected one bold in the heading color
                 with a 2 px lavender underline. Radio buttons, so a screen reader hears one selected of three. -->
            <Style x:Key="BrandTabStyle" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Label.Foreground" Value="{ThemeResource BrandHeadingBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Label.Foreground" Value="{ThemeResource BrandHeadingBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Label.Foreground" Value="{ThemeResource BrandDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Label.FontWeight" Value="Bold" />
                                                <Setter Target="Label.Foreground" Value="{ThemeResource BrandHeadingBrush}" />
                                                <Setter Target="Underline.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Label" Margin="0,10,0,10" Content="{TemplateBinding Content}"
                                    FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                    Foreground="{ThemeResource BrandMutedBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Opacity="0"
                                    Background="{ThemeResource BrandAccentBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The brand's switch, as the Mac's BrandSwitchStyle: a 38×22 track, square-cornered like every control,
                 violet when on; a 16×16 knob 3 px in. Hover darkens the track; disabled, the whole switch fades. -->
            <Style x:Key="BrandSwitchStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="Track" Background="{ThemeResource BrandRestFillBrush}" BorderBrush="{ThemeResource BrandBorderStrongBrush}"
                                  BorderThickness="1" CornerRadius="{StaticResource BrandControlRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Track.Background" Value="{ThemeResource BrandSwitchOffHoverBrush}" />
                                                <Setter Target="Track.BorderBrush" Value="{ThemeResource BrandSwitchOffHoverEdgeBrush}" />
                                                <Setter Target="Knob.Background" Value="{ThemeResource BrandSwitchOffHoverKnobBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Track.Background" Value="{ThemeResource BrandSwitchOffHoverBrush}" />
                                                <Setter Target="Track.BorderBrush" Value="{ThemeResource BrandSwitchOffHoverEdgeBrush}" />
                                                <Setter Target="Knob.Background" Value="{ThemeResource BrandSwitchOffHoverKnobBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Track.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Track.Background" Value="{ThemeResource BrandPrimaryBrush}" />
                                                <Setter Target="Track.BorderBrush" Value="Transparent" />
                                                <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                                <Setter Target="Knob.Background" Value="{ThemeResource BrandOnPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Track.Background" Value="{ThemeResource BrandPrimaryHoverBrush}" />
                                                <Setter Target="Track.BorderBrush" Value="Transparent" />
                                                <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                                <Setter Target="Knob.Background" Value="{ThemeResource BrandOnPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Track.Background" Value="{ThemeResource BrandPrimaryHoverBrush}" />
                                                <Setter Target="Track.BorderBrush" Value="Transparent" />
                                                <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                                <Setter Target="Knob.Background" Value="{ThemeResource BrandOnPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="Track.Background" Value="{ThemeResource BrandPrimaryBrush}" />
                                                <Setter Target="Track.BorderBrush" Value="Transparent" />
                                                <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                                <Setter Target="Knob.Background" Value="{ThemeResource BrandOnPrimaryBrush}" />
                                                <Setter Target="Track.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                        <VisualState x:Name="IndeterminatePointerOver" />
                                        <VisualState x:Name="IndeterminatePressed" />
                                        <VisualState x:Name="IndeterminateDisabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Knob" Width="16" Height="16" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="{StaticResource BrandBadgeRadius}" Background="{ThemeResource BrandMutedBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The brand's field, as the Mac's FieldBox: the page's background, a 1 px strong edge, lavender with a
                 3 px lavender ring at 30 % while focused. No clear button. A field that's wrong gets a red edge from
                 its own view's state. Single line, centred; BrandEditorStyle below is the multi-line box. -->
            <Style x:Key="BrandFieldStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource BrandHeadingBrush}" />
                <Setter Property="Background" Value="{ThemeResource BrandBgBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BrandBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource BrandControlRadius}" />
                <Setter Property="Padding" Value="10,0,10,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SelectionHighlightColor" Value="{ThemeResource BrandPrimaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="Box.BorderBrush" Value="{ThemeResource BrandAccentBrush}" />
                                                <Setter Target="Ring.Opacity" Value="0.3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentElement.Foreground" Value="{ThemeResource BrandDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Ring" Margin="-3" BorderThickness="3" CornerRadius="9" Opacity="0" IsHitTestVisible="False"
                                        BorderBrush="{ThemeResource BrandAccentBrush}" />
                                <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                                <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}"
                                    HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                    IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                    IsTabStop="False" ZoomMode="Disabled" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A message box, as the Mac's BrandTextEditor: the same field (its template, for a RichEditBox), several
                 lines that wrap and scroll. A RichEditBox because only it can space lines (19 apart, as the Mac's
                 13-point lines with lineSpacing(3), set by MessageRowView); it is kept to plain text: no formatting
                 keys, copies as plain text, pastes as plain text (MessageRowView). -->
            <Style x:Key="BrandEditorStyle" TargetType="RichEditBox">
                <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource BrandHeadingBrush}" />
                <Setter Property="Background" Value="{ThemeResource BrandBgBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BrandBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource BrandControlRadius}" />
                <!-- The Mac's 10×7, less 3 at the top: RichEdit puts a line's extra space above its text, the Mac below. -->
                <Setter Property="Padding" Value="10,4,10,7" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="SelectionHighlightColor" Value="{ThemeResource BrandPrimaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="DisabledFormattingAccelerators" Value="All" />
                <Setter Property="ClipboardCopyFormat" Value="PlainText" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RichEditBox">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="Box.BorderBrush" Value="{ThemeResource BrandAccentBrush}" />
                                                <Setter Target="Ring.Opacity" Value="0.3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentElement.Foreground" Value="{ThemeResource BrandDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Ring" Margin="-3" BorderThickness="3" CornerRadius="9" Opacity="0" IsHitTestVisible="False"
                                        BorderBrush="{ThemeResource BrandAccentBrush}" />
                                <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                                <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}"
                                    HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                    IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                    IsTabStop="False" ZoomMode="Disabled" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- − and + beside a number, as the Mac's StepButton: a glyph in the heading color, a hover fill. They
                 don't take focus from a click, so the number keeps it; Tab still reaches them. -->
            <Style x:Key="BrandStepButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="25" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Fill" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandHoverBrush}" />
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandSecondaryHoverTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Background" Value="{ThemeResource BrandHoverBrush}" />
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandSecondaryHoverTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Foreground" Value="{ThemeResource BrandDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" Foreground="{ThemeResource BrandHeadingBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A 1 px line in the brand's border color: between a card's rows, under its header and under the tab bar
                 (the Mac's Rule). A style, so rules made in code follow a theme switch too. -->
            <Style x:Key="BrandRuleStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource BrandBorderBrush}" />
            </Style>

            <Style x:Key="SeparatorStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="-4,4,-4,4" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
