<UserControl
    x:Class="ContextGuard.App.FieldRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- A number in a card, as the Mac's NumberField: its label, a 64-wide box, its unit and − | + joined in one
         bordered control. A number to fix gets a red edge (a visual state, so it follows a live theme switch); in high
         contrast, where red is the text color, a 2 px edge. -->
    <Grid x:Name="Root" Padding="16,0,16,0" MinHeight="44" ColumnSpacing="32">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Validity">
                <VisualState x:Name="Valid" />
                <VisualState x:Name="Invalid">
                    <VisualState.Setters>
                        <Setter Target="Box.BorderBrush" Value="{ThemeResource BrandDangerBrush}" />
                        <Setter Target="Box.BorderThickness" Value="{ThemeResource BrandInvalidEdgeThickness}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Label" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="{StaticResource BrandFont}"
                   FontSize="13" Foreground="{ThemeResource BrandHeadingBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBox x:Name="Box" Width="64" Height="30" Style="{StaticResource BrandFieldStyle}" TextAlignment="Right"
                     TextChanged="OnTextChanged" />
            <TextBlock x:Name="Unit" Width="72" VerticalAlignment="Center" TextTrimming="None" FontFamily="{StaticResource BrandFont}"
                       FontSize="13" Foreground="{ThemeResource BrandMutedBrush}" />
            <Border Height="30" BorderThickness="1" CornerRadius="{StaticResource BrandControlRadius}"
                    BorderBrush="{ThemeResource BrandBorderStrongBrush}" Background="{ThemeResource BrandPanelBrush}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="Less" Style="{StaticResource BrandStepButtonStyle}" CornerRadius="5,0,0,5" Click="OnLess">
                        <FontIcon Glyph="&#xE738;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                    </Button>
                    <Border Width="1" Background="{ThemeResource BrandBorderStrongBrush}" />
                    <Button x:Name="More" Style="{StaticResource BrandStepButtonStyle}" CornerRadius="0,5,5,0" Click="OnMore">
                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
